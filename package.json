{
  "name": "biovity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "bun run sync:maplibre",
    "dev": "next dev --turbopack",
    "dev:portless": "portless biovity next dev --turbopack",
    "prebuild": "bun run sync:maplibre",
    "build": "next build --turbopack",
    "analyze": "NODE_OPTIONS='--max-old-space-size=4096' ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "clean": "rm -rf .next",
    "postinstall": "bun run sync:maplibre",
    "sync:maplibre": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/react": "^4.0.147",
    "@base-ui/react": "^1.9.0",
    "@better-auth/infra": "^0.4.20",
    "@better-auth/sso": "1.7.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@rive-app/react-webgl2": "^4.36.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@takumi-rs/helpers": "^2.16.3",
    "@tanstack/react-query": "^5.104.3",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/dompurify": "^3.2.0",
    "@types/glob": "^9.0.0",
    "@types/leaflet": "^1.9.22",
    "@typesafe-ai/sdk": "0.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.143",
    "ai-elements": "^1.9.1",
    "ansi-to-react": "^6.2.6",
    "better-auth": "1.7.10",
    "better-result": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.17",
    "embla-carousel-react": "^8.6.0",
    "featurebase-js": "^1.0.3",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "html-react-parser": "^6.1.8",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "marked": "^18.1.1",
    "media-chrome": "^4.19.3",
    "motion": "^14.3.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "next-mdx-remote": "6.0.0",
    "nuqs": "^2.10.2",
    "openai": "^7.36.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.18",
    "recharts": "3.10.1",
    "resend": "^6.34.1",
    "shadcn": "^4.22.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "takumi-pdf": "^0.17.4",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@types/geojson": "^7946.0.16",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "biome": {
    "formatter": {
      "lineWidth": 100,
      "semiColons": "asNeeded"
    },
    "linter": {
      "rules": {
        "recommended": true,
        "stylistic": true,
        "noExplicitAny": "error",
        "noUnusedVariables": "warn"
      }
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prosemirror-model": "1.25.11"
  }
}
